    "row2": ["Tab 1.5u", "12 × 1u", "\\ 1.5u (char key)"],
    "row3": ["Caps Lock 1.75u", "11 × 1u", "Enter 2.25u"],
    "row4": ["Shift 2.25u", "10 × 1u", "Shift 2.75u"],
